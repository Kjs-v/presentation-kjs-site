  "slides": [
    {
      "id": "cover",
      "kind": "cover",
      "title": "Your Brand, Our Expertise",
      "summary": "Food processing and contract packaging",
      "image": "/media/units/unit-1.jpg"
    },
    {
      "id": "overview",
      "kind": "facts",
      "title": "KJS India at a glance",
      "summary": "Contract food manufacturing from ingredient preparation to packed goods ready for dispatch.",
      "items": [
        {
          "title": "Processing",
          "body": "Dry blending distributes ingredients evenly. Ball milling refines chocolate and other confectionery bases."
        },
        {
          "title": "Packaging",
          "body": "The pack format depends on the product and its intended use, from a single portion to an outer shipping case."
        },
        {
          "title": "Warehousing",
          "body": "Ingredients, packaging and finished goods are stored separately, with dedicated staff for dispatch."
        }
      ]
    },
    {
      "id": "packaging",
      "kind": "facts",
      "title": "Packaging formats",
      "summary": "Pack format can be tailored to the product and the customer’s specifications.",
      "items": [
        {
          "title": "Pouches",
          "body": "Form-fill-seal equipment shapes film into a pouch, fills it and seals it, in vertical and horizontal formats."
        },
        {
          "title": "Cartons",
          "body": "A pouch-in-carton uses an inner pouch. Direct-fill cartons carry the product in the carton itself."
        },
        {
          "title": "Outer packaging",
          "body": "A bag-in-box combines a flexible bag with a rigid box. A master shipper groups packs for dispatch."
        }
      ]
    },
    {
      "id": "quality",
      "kind": "facts",
      "title": "Quality and testing",
      "summary": "Process controls, internal checks and external microbiological testing.",
      "items": [
        {
          "title": "Process controls",
          "body": "HACCP plans include screening, magnets and metal detection."
        },
        {
          "title": "Internal checks",
          "body": "Particle size, bulk density, moisture and pH."
        },
        {
          "title": "External checks",
          "body": "External microbiological testing covers pathogens and spoilage organisms."
        }
      ]
    },
