# Copy this file to .env and fill in the values. Never commit .env.
# Ask the project owner for the real values.

# Development database (local work and tests). Never point local work at production.
DATABASE_URL=            # Neon pooled connection string, database kjs_dev (host contains "-pooler")
DATABASE_URL_UNPOOLED=   # Same, without "-pooler" in the host (used for migrations)

# Production database: only used once, for the go-live migration. Vercel holds its own copy.
PRODUCTION_DATABASE_URL=
PRODUCTION_DATABASE_URL_UNPOOLED=

# First admin login created by `npm run db:seed`
ADMIN_EMAIL=

# Random string used to sign admin login sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Vercel Blob token for image/video uploads
BLOB_READ_WRITE_TOKEN=
